# Standalone single-container image for portable execution on macOS ARM64 or Linux x86_64.
FROM python:3.12.8-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=0 \
    SECOPS_RUNTIME_MODE=local_native \
    SECOPS_API_HOST=0.0.0.0 \
    SECOPS_API_PORT=8080

COPY pyproject.toml uv.lock .python-version README.md ./
COPY models ./models
COPY ingestion ./ingestion
COPY processing ./processing
COPY services ./services
COPY schemas ./schemas
COPY apps ./apps
COPY scripts/entrypoint_standalone.sh ./scripts/entrypoint_standalone.sh

RUN uv sync --frozen --no-dev && chmod +x ./scripts/entrypoint_standalone.sh

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD .venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')"

ENTRYPOINT ["./scripts/entrypoint_standalone.sh"]
