# Runtime mode: local_native (zero-Docker) or distributed (Docker Compose)
SECOPS_RUNTIME_MODE=local_native
SECOPS_DATA_DIR=.local_data
SECOPS_API_HOST=127.0.0.1
SECOPS_API_PORT=8080

# Cryptographic Tokenization & Vault Settings (DEV ONLY defaults - inject via OpenBao/KMS in production!)
SECOPS_HMAC_MASTER_KEY=dev-only-hmac-key-replace-via-openbao-transit-32b
SECOPS_KEY_VERSION=v1
SECOPS_K_ANONYMITY_THRESHOLD=5
SECOPS_RAW_RETENTION_DAYS=7
SECOPS_SILVER_RETENTION_DAYS=90
SECOPS_GOLD_RETENTION_DAYS=365

# Optional external OPA policy sidecar (leave empty to use embedded OPA-parity evaluator)
SECOPS_OPA_URL=

# Dev/Demo API keys (override with OIDC/JWT + OpenBao dynamic secrets in production)
SECOPS_KEY_ANALYST=secops-dev-analyst-key
SECOPS_KEY_SOC=secops-dev-soc-key
SECOPS_KEY_IR_LEAD=secops-dev-ir-lead-key
SECOPS_KEY_PRIVACY_OFFICER=secops-dev-privacy-officer-key

# Container architecture override for OpenTelemetry Collector (arm64 or amd64)
OTEL_ARCH=arm64
